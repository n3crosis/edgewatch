{
    "name": "edgewatch/laravel-edgewatch",
    "description": "Laravel client for EdgeWatch, wire-compatible with the Laravel Nightwatch agent protocol.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "observability", "apm", "nightwatch", "cloudflare"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "suggest": {
        "ext-curl": "Required for the direct HTTP transport."
    },
    "autoload": {
        "psr-4": {
            "EdgeWatch\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdgeWatch\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdgeWatch\\Laravel\\EdgeWatchServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
