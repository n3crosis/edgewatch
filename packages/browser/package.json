{
  "name": "@edgewatch/browser",
  "version": "0.1.0",
  "description": "Tiny, dependency-free browser error reporter for EdgeWatch (POST /api/browser).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  }
}
