{
  "name": "edgewatch",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:dashboard": "pnpm --filter @edgewatch/dashboard dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:php": "cd packages/laravel-edgewatch && composer test && cd ../../examples/laravel-sandbox && ./vendor/bin/pest",
    "typecheck": "pnpm -r typecheck",
    "e2e": "bash scripts/e2e.sh"
  }
}
