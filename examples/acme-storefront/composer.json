{
    "name": "acme/storefront",
    "type": "project",
    "description": "Acme Storefront — standalone Laravel demo app that generates 3 days of realistic logs and application telemetry.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "demo": [
            "@php artisan demo:generate --days=3"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
