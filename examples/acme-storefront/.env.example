APP_NAME="Acme Storefront"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=array
MAIL_MAILER=array
LOG_CHANNEL=stack
LOG_STACK=single,nightwatch

# Official laravel/nightwatch agent, pointed at EdgeWatch.
# NIGHTWATCH_TOKEN: an EdgeWatch ingest key (create-key acme-storefront ingest); its project receives the data.
# NIGHTWATCH_BASE_URL: the EdgeWatch ingest origin; only `php artisan nightwatch:agent` reads it.
NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=
NIGHTWATCH_BASE_URL=https://edgewatch-ingest.example.workers.dev
NIGHTWATCH_SERVER=acme-web-1
