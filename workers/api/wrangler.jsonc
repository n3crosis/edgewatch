{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edgewatch-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "API_KEYS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "d1_databases": [{ "binding": "DB", "database_name": "edgewatch", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "TRACES", "bucket_name": "edgewatch-traces" }],
  "vars": { "CORS_ORIGIN": "*" }
}
