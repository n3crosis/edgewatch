{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edgewatch-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "API_KEYS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "edgewatch-ingest" }] },
  "r2_buckets": [{ "binding": "TRACES", "bucket_name": "edgewatch-traces" }],
  "vars": { "TOKEN_TTL": "3600", "MAX_BODY_BYTES": "20000000" }
  // Secret: wrangler secret put TOKEN_SIGNING_SECRET
}
